{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // DOM: Playwright's types, and the code page.evaluate runs in the browser.
    "lib": ["ES2023", "DOM"],
    "types": ["node"]
  },
  "include": ["."],
  // The Worker entry has Workers types: worker/tsconfig.json.
  "exclude": ["worker"]
}
