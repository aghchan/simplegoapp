{
  "frontendGlobs": ["basetobase/dashboard/**"],
  "riskGlobs": [
    "**/*auth*",
    "**/*auth*/**",
    "**/*payment*",
    "**/*billing*",
    "**/*secret*",
    "**/session*",
    "**/oidc*",
    "config.yml",
    "local.yml",
    "**/*payment*/**",
    "**/*billing*/**",
    "**/*secret*/**",
    "**/session*/**",
    "**/oidc*/**"
  ],
  "infraGlobs": [
    ".github/**",
    "**/migrations/**",
    "**/wrangler.jsonc",
    "Makefile",
    "go.mod",
    "basetobase/package.json"
  ],
  "thresholds": {
    "greenLines": 50,
    "greenFiles": 3,
    "blueLines": 300,
    "doubleBlackLines": 1000,
    "doubleBlackTopDirs": 4
  },
  "trailNames": {
    "green": ["Easy Slider", "Ramp Run", "Bunny Hill"],
