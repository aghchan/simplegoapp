{
  "name": "basetobase",
  "main": "dispatch/src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Workers Logs: console output, readable later in the Cloudflare dashboard.
  "observability": { "enabled": true },
  // The reconcile cron (dispatch/src/reconcile/cron.ts): GitHub never redelivers a failed webhook.
  "triggers": { "crons": ["*/5 * * * *"] },
  "durable_objects": {
    "bindings": [
      { "name": "RUNS", "class_name": "RunDO" },
      { "name": "LOBBY", "class_name": "LobbyDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RunDO"] },
    { "tag": "v2", "new_sqlite_classes": ["LobbyDO"] }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "basetobase",
      // Replace with the id printed by `wrangler d1 create basetobase`.
      "database_id": "81befb0c-5399-425b-8584-369f370c8444",
      "migrations_dir": "dispatch/migrations"
    }
  ],
  // The running version: its id and tag (the commit the deploy job shipped). GET /health reports it.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "kv_namespaces": [
    {
      "binding": "TRANSCRIPTS",
      // Replace with the id printed by `npx wrangler kv namespace create basetobase-transcripts`.
      "id": "4e34e13ae0a845539c1654771f0d03da"
    }
  ],
  "assets": {
    "directory": "dashboard/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*", "/github/*", "/agent/*", "/health"]
  },
  "vars": {
    "OWNER_LOGIN": "aghchan",
    "REPO": "aghchan/simplegoapp",
    "AGENT_WORKFLOW": "basetobase-agent.yml",
    // Replace with the deployed origin, https://basetobase.<subdomain>.workers.dev.
    "PUBLIC_URL": "https://basetobase.soulygrail.workers.dev",
    "GITHUB_API": "https://api.github.com"
  }
}
